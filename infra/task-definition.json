{
  "family": "openwhisper",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::241820142018:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "241820142018.dkr.ecr.us-east-1.amazonaws.com/openwhisper-backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "OPENWHISPER_HOST", "value": "0.0.0.0" },
        { "name": "OPENWHISPER_PORT", "value": "8000" },
        { "name": "OPENWHISPER_WHISPER_MODEL", "value": "base" },
        { "name": "OPENWHISPER_WHISPER_DEVICE", "value": "cpu" },
        {
          "name": "OPENWHISPER_CORS_ORIGINS",
          "value": "[\"https://openwhispr.space\",\"https://www.openwhispr.space\"]"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\" || exit 1"],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 300
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/openwhisper",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "backend"
        }
      },
      "cpu": 1024,
      "memory": 2048
    },
    {
      "name": "web",
      "image": "241820142018.dkr.ecr.us-east-1.amazonaws.com/openwhisper-web:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "NODE_ENV", "value": "production" },
        {
          "name": "OPENWHISPER_BACKEND_URL",
          "value": "http://localhost:8000"
        }
      ],
      "dependsOn": [
        {
          "containerName": "backend",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q --spider http://localhost:3000/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/openwhisper",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "web"
        }
      },
      "cpu": 512,
      "memory": 1024
    }
  ]
}
