# OpenWhisper Docker Compose Configuration
# Copy to .env and fill in your values

# ─── Groq API (cloud STT + AI) ───────────────────────────
# Free key at https://console.groq.com
NEXT_PUBLIC_GROQ_API_KEY=
OPENWHISPER_GROQ_API_KEY=

# ─── OpenAI API (optional, for GPT-4o-mini) ──────────────
NEXT_PUBLIC_OPENAI_API_KEY=
OPENWHISPER_OPENAI_API_KEY=

# ─── Whisper Model (backend) ─────────────────────────────
# Options: tiny, base, small, medium, large-v3
OPENWHISPER_WHISPER_MODEL=base
# Options: auto, cpu, cuda
OPENWHISPER_WHISPER_DEVICE=auto
