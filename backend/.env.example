# OpenWhisper Backend Configuration
# Copy to .env and fill in your values

# ─── Whisper (local STT) ────────────────────────────────
# Model: tiny, base, small, medium, large-v3
OPENWHISPER_WHISPER_MODEL=base
# Device: auto, cpu, cuda
OPENWHISPER_WHISPER_DEVICE=auto

# ─── Groq API (cloud STT + AI post-processing) ─────────
# Free key at https://console.groq.com
OPENWHISPER_GROQ_API_KEY=

# ─── OpenAI API (optional, for GPT-4o-mini) ────────────
OPENWHISPER_OPENAI_API_KEY=

# ─── Ollama (optional, for local LLM) ──────────────────
OPENWHISPER_OLLAMA_URL=http://localhost:11434
OPENWHISPER_OLLAMA_MODEL=llama3.2

# ─── Server ─────────────────────────────────────────────
OPENWHISPER_HOST=0.0.0.0
OPENWHISPER_PORT=8000
# Comma-separated list of allowed origins
OPENWHISPER_CORS_ORIGINS=["http://localhost:3000"]
